<RCC>
    <qresource prefix="/styles">
        <file>friction.qss</file>
    </qresource>
    <qresource prefix="/cursors">
        <file alias="cursor-node.xpm">pixmaps/cursor-node.xpm</file>
        <file alias="cursor_color_picker.png">pixmaps/cursor_color_picker.png</file>
        <file alias="cursor_crosshair_precise_open.png">pixmaps/cursor_crosshair_precise_open.png</file>
        <file alias="cursor_crosshair_open.png">pixmaps/cursor_crosshair_open.png</file>
        <file alias="cursor-ellipse.xpm">pixmaps/cursor-ellipse.xpm</file>
        <file alias="cursor-rect.xpm">pixmaps/cursor-rect.xpm</file>
        <file alias="cursor-text.xpm">pixmaps/cursor-text.xpm</file>
        <file alias="cursor-pen.xpm">pixmaps/cursor-pen.xpm</file>
        <file alias="cursor-pencil.xpm">pixmaps/cursor-pencil.xpm</file>
    </qresource>
    <qresource prefix="/other"/>
    <qresource prefix="/checkbox">
        <file alias="Checkbox_checked_normal.png">pixmaps/Checkbox_checked_normal.png</file>
        <file alias="Checkbox_checked_disabled.png">pixmaps/Checkbox_checked_disabled.png</file>
    </qresource>
    <qresource prefix="/arrows">
        <file alias="up-arrow.png">pixmaps/up-arrow.png</file>
        <file alias="down-arrow.png">pixmaps/down-arrow.png</file>
    </qresource>
    <qresource prefix="/config"/>
    <qresource prefix="/icons">
        <file alias="bone.svg">../ui/widgets/bone_icon.svg</file>
        <file alias="bone_pose.svg">../ui/widgets/bone_pose.svg</file>
        <file alias="bone_parent.svg">../ui/widgets/bone_parent.svg</file>
        <file alias="bone_bind.svg">../ui/widgets/bone_bind.svg</file>
        <file alias="bone_select.svg">../ui/widgets/bone_select.svg</file>
        <file alias="camera_tool.svg">../ui/widgets/camera_tool.svg</file>
        <file alias="pen_tool.svg">../ui/widgets/pen_tool.svg</file>
        <file alias="clip_canvas.svg">../ui/widgets/clip_canvas.svg</file>
        <file alias="top_view.svg">../ui/widgets/top_view.svg</file>
        <file alias="canvas_rulers.svg">../ui/widgets/canvas_rulers.svg</file>
        <file alias="loop_fwd.svg">../ui/widgets/loop_fwd.svg</file>
        <file alias="loop_pingpong.svg">../ui/widgets/loop_pingpong.svg</file>
        <file alias="loop_skip.svg">../ui/widgets/loop_skip.svg</file>
    </qresource>
    <qresource prefix="/assets">
        <file alias="mascot.svg">assets/mascot.svg</file>
    </qresource>

    <qresource prefix="/translations">
        <file alias="friction_zh_CN.qm">translations/friction_zh_CN.qm</file>
    </qresource>
    <qresource prefix="/">
        <file>presets/render/008-friction-preset-exr.conf</file>
        <file>presets/render/007-friction-preset-webm.conf</file>
        <file>presets/render/006-friction-preset-tiff.conf</file>
        <file>presets/render/005-friction-preset-png.conf</file>
        <file>presets/render/004-friction-preset-prores-444-aac.conf</file>
        <file>presets/render/003-friction-preset-prores-444.conf</file>
        <file>presets/render/002-friction-preset-mp4-h264-mp3.conf</file>
        <file>presets/render/001-friction-preset-mp4-h264.conf</file>
        <file>xdg/friction.xml</file>
        <file>xdg/friction.desktop</file>
        <file>icons/hicolor/scalable/apps/graphics.friction.Friction.svg</file>
        <file>icons/friction-splash.png</file>
    </qresource>
</RCC>
